// Every error code: its variant, its name and its exit code, one to a line. Add a code
// at the end of this list, and to `docs/exit-codes.md` and `tests/error_codes.txt`.
error_codes! {
    Usage => "usage" => Usage,
    HomeUnresolved => "home_unresolved" => Failure,
    NoWallet => "no_wallet" => NoAgentNode,
    PassphraseMissing => "passphrase_missing" => Failure,
    PassphraseUnreadable => "passphrase_unreadable" => Failure,
    PassphraseWrong => "passphrase_wrong" => Failure,
    KeystoreCorrupt => "keystore_corrupt" => Failure,
    Io => "io" => Failure,
    NoAgentNode => "no_agent_node" => NoAgentNode,
    ConnectorFailed => "connector_failed" => Failure,
    AlreadyRunning => "already_running" => Failure,
    AppFailed => "app_failed" => Failure,
    Unfunded => "unfunded" => Failure,
    FaucetUnavailable => "faucet_unavailable" => Failure,
    NotRunning => "not_running" => Failure,
    SendFailed => "send_failed" => Failure,
    SystemdFailed => "systemd_failed" => Failure,
    UnknownName => "unknown_name" => Failure,
    PeerFailed => "peer_failed" => Failure,
    PeerNotPeerable => "peer_not_peerable" => Failure,
    RouteFailed => "route_failed" => Failure,
    ChainFailed => "chain_failed" => Failure,
    ChannelFailed => "channel_failed" => Failure,
    NotConfirmed => "not_confirmed" => Failure,
    SpendingLimit => "spending_limit" => Failure,
    NameTaken => "name_taken" => Failure,
    QueryFailed => "query_failed" => Failure,
    DraftRefused => "draft_refused" => Failure,
    ConfirmationRequired => "confirmation_required" => Failure,
    OverlayUnavailable => "overlay_unavailable" => Failure,
    FundsHeld => "funds_held" => Failure,
    LastToonApp => "last_toon_app" => Failure,
    JoinRefused => "join_refused" => Failure,
    RelayNotPayable => "relay_not_payable" => Failure,
    PeeringNeeded => "peering_needed" => Failure,
    OneRelay => "one_relay" => Failure,
    NoFollowList => "no_follow_list" => Failure,
    DescribeFailed => "describe_failed" => Failure,
}
